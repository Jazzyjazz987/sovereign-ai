# Hugging Face token pour modèles privés
HF_TOKEN=hf_your_token_here

# Anthropic API key pour Claude Sonnet (T5)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LiteLLM master key (router T1→T5)
LITELLM_MASTER_KEY=sk-litellm-your-key-here

# vLLM API key
VLLM_API_KEY=your-vllm-key-here

# PostgreSQL password
POSTGRES_PASSWORD=your-postgres-password-here

# Grafana admin password
GRAFANA_PASSWORD=your-grafana-password-here

# (Optional) vLLM ports for T3 et T4
VLLM_T3_PORT=8001
VLLM_T4_PORT=8002
