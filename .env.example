# --- Sovereign AI — variables d'environnement ---------------------------------------
# Copier vers .env (git-ignoré) et renseigner. Sur la boîte cloisonnée : permissions
# fichier strictes, pas de vault (décision opérateur).

# Hugging Face — modèles privés (télécharge e5-base / GLiNER au 1er build)
HF_TOKEN=hf_your_token_here

# Anthropic — Claude, tier T5 (escalade « inférence centrale », intérim).
# "disabled" ou clé absente => 100 % local (aucun appel cloud).
ANTHROPIC_API_KEY=sk-ant-your-key-here
T5_MODEL=claude-sonnet-5          # budget minimal : claude-haiku-4-5
T5_MAX_TOKENS=700
T5_MAX_CALLS=150                  # plafond d'appels par process (compteur NON durable — cf. revue)
T5_MODERATION=on                  # on = chaque appel T5 attend une approbation (POST /t5/{id}/approve)
T5_APPROVAL_TIMEOUT=60
T5_NOTIFY_WEBHOOK=                # URL (ntfy/Telegram/Slack/script) — métadonnées seules

# PostgreSQL (pgvector — cœur du RAG) + Grafana
POSTGRES_PASSWORD=your-postgres-password-here
GRAFANA_PASSWORD=your-grafana-password-here

# GPU (RTX 3080 Ti). GPU_DEVICE_COUNT=1 active le passthrough + les exporters GPU.
GPU_DEVICE_COUNT=1
OLLAMA_CPU_ONLY=0
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m

# RAG
RAG_ENABLED=on
RAG_STRICT=on                     # question support sans fiche => « aucune fiche » (pas de génération libre)
RAG_CACHE_TTL=3600
RAG_ADMIN_TOKEN=                  # vide => POST /ingest fermé (403). Poser un jeton pour l'activer.
RAG_TORCH_THREADS=8
RAG_MAX_CONCURRENCY=3

# Anone (anonymisation PII)
ANONE_THRESHOLD=0.4               # bas = sur-masquer (direction sûre pour le fail-closed cloud)

# Divers
QUERY_DEADLINE=180               # plafond dur d'une requête /query (secondes)
OLLAMA_TIMEOUT=90
HF_HUB_OFFLINE=1                 # 0 seulement pour un 1er build / une MAJ de modèle
TRANSFORMERS_OFFLINE=1
