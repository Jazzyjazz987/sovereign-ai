# Hugging Face token pour modèles privés
HF_TOKEN=hf_your_token_here

# Anthropic API key pour Claude (T5). Mettre "disabled" pour couper le cloud (mode 100% souverain).
ANTHROPIC_API_KEY=sk-ant-your-key-here
# T5 — garde-fous de coût (budget serré). Défauts dans le code si absents.
T5_MODEL=claude-sonnet-5          # budget minimal : claude-haiku-4-5 (~5x moins cher en sortie)
T5_MAX_TOKENS=700                 # plafond de tokens générés par réponse T5
T5_MAX_CALLS=150                  # plafond d'appels cloud par process (au-delà : repli local)

# LiteLLM master key (router T1→T5)
LITELLM_MASTER_KEY=sk-litellm-your-key-here

# vLLM API key
VLLM_API_KEY=your-vllm-key-here

# PostgreSQL password
POSTGRES_PASSWORD=your-postgres-password-here

# Grafana admin password
GRAFANA_PASSWORD=your-grafana-password-here

# (Optional) vLLM ports for T3 et T4
VLLM_T3_PORT=8001
VLLM_T4_PORT=8002
