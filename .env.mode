# Sovereign AI Stack — Execution Mode Configuration
# Toggle between CPU and GPU execution

# Set to "cpu" or "gpu"
EXECUTION_MODE=gpu

# CPU-only settings (when EXECUTION_MODE=cpu)
OLLAMA_CPU_ONLY=0
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# GPU settings (when EXECUTION_MODE=gpu)
# These are applied when EXECUTION_MODE=gpu
GPU_DEVICE_COUNT=1
GPU_CAPABILITY=compute,utility
VRAM_BUDGET=12GB
