{
  "uid": "sovereign-rag",
  "title": "Sovereign AI — Portail RAG",
  "tags": ["sovereign-ai", "rag"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requêtes /query par voie (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "normal" } } } },
      "targets": [ { "expr": "sum by (tier) (rate(query_requests_total[5m]))", "legendFormat": "{{tier}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Issues du portail RAG (rag_answers_total)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "expr": "sum by (outcome) (rate(rag_answers_total[5m]))", "legendFormat": "{{outcome}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Latence /query p95 par voie (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(query_latency_seconds_bucket[5m])))", "legendFormat": "{{tier}}" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Taux de service par le cache T0 (15 min)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [ { "expr": "sum(rate(query_cache_hits_total[15m])) / clamp_min(sum(rate(query_requests_total[15m])), 0.0001)" } ]
    },
    {
      "id": 5, "type": "stat", "title": "Réponses fondées sur fiches (part, 1 h)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.4 }, { "color": "green", "value": 0.6 } ] } } },
      "targets": [ { "expr": "sum(rate(rag_answers_total{outcome=~\"answered|answered_low_conf\"}[1h])) / clamp_min(sum(rate(rag_answers_total[1h])), 0.0001)" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "RAG /search — latence p95 (s) & en cours",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(rag_search_latency_seconds_bucket[5m]))", "legendFormat": "p95 latence" },
        { "expr": "rag_search_inflight", "legendFormat": "en cours" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Signaux à surveiller (15 min / 1 h)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "description": "Non filtré (C7), citations rejetées (C3/D2), contrat cassé (D5), /search saturé (C14), timeouts (D4)",
      "targets": [
        { "expr": "increase(query_ungated_no_scope_total[1h])", "legendFormat": "requêtes non filtrées (1h)" },
        { "expr": "increase(rag_answers_total{outcome=\"citation_invalide\"}[1h])", "legendFormat": "citations rejetées (1h)" },
        { "expr": "increase(rag_answers_total{outcome=\"parse_error\"}[15m])", "legendFormat": "contrat JSON KO (15m)" },
        { "expr": "increase(rag_search_busy_total[15m])", "legendFormat": "/search saturé 503 (15m)" },
        { "expr": "increase(query_requests_total{tier=\"timeout\"}[15m])", "legendFormat": "timeouts /query (15m)" }
      ]
    }
  ]
}
