{
  "uid": "sovereign-stack",
  "title": "Sovereign AI — Stack & Infra",
  "tags": ["sovereign-ai", "infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "state-timeline", "title": "Services (up)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [ { "expr": "up{job=~\"langgraph|anone|rag|node|postgres|gpu|prometheus\"}", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "/query — req/s par voie",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [ { "expr": "sum by (tier) (rate(query_requests_total[5m]))", "legendFormat": "{{tier}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "/query — latence p95 par voie (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(query_latency_seconds_bucket[5m])))", "legendFormat": "{{tier}}" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Taux d'erreur /query (10 min)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.02 }, { "color": "red", "value": 0.1 } ] } } },
      "targets": [ { "expr": "sum(rate(query_requests_total{status=\"error\"}[10m])) / clamp_min(sum(rate(query_requests_total[10m])), 0.0001)" } ]
    },
    {
      "id": 5, "type": "stat", "title": "Appels cloud T5 (1 h)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 14 },
      "targets": [ { "expr": "increase(t5_cloud_calls_total[1h])" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Anone — anonymisations / échecs 503",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [ { "expr": "sum by (status) (rate(anonymize_requests_total[5m]))", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Hôte — RAM / disque utilisés (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } },
      "targets": [
        { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "RAM" },
        { "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/host\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/host\",fstype!~\"tmpfs|overlay\"})) * 100", "legendFormat": "disque {{mountpoint}}" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "PostgreSQL — connexions actives",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [ { "expr": "sum(pg_stat_activity_count)", "legendFormat": "connexions" } ]
    },
    {
      "id": 9, "type": "stat", "title": "Cache T0 — entrées",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 },
      "targets": [ { "expr": "sum(rate(query_cache_hits_total[15m]))", "legendFormat": "hits/s (15m)" } ]
    }
  ]
}
